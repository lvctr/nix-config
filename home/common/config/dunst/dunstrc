[global]
font=Source Han Code JP 12
markup=full
format=<b>%s</b>\n%b
sort=yes
indicate_hidden=yes
alignment=left
bounce_freq=0
show_age_threshold=60
word_wrap=yes
ignore_newline=no
geometry=300x5-30+50
transparency=0
idle_threshold=120
monitor=0
follow=mouse
sticky_history=yes
line_height=0
separator_height=2
padding=12
horizontal_padding=12
separator_color=frame
frame_width=2
frame_color=#586e75
corner_radius=8

[urgency_low]
background=#002b36
foreground=#839496
timeout=5

[urgency_normal]
background=#002b36
foreground=#839496
timeout=8

[urgency_critical]
background=#002b36
foreground=#dc322f
frame_color=#dc322f
timeout=0