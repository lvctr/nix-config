# See dunst(5) for all configuration options

[global]
	monitor = 1
	follow = none

	width = 400
	height = 400
	origin = bottom-right
	offset = 8x8
	scale = 0
	notification_limit = 0

	progress_bar = false
	progress_bar_height = 10
	progress_bar_frame_width = 1
	progress_bar_min_width = 150
	progress_bar_max_width = 300

	indicate_hidden = yes
	transparency = 0
	separator_height = 1
	padding = 9
	horizontal_padding = 9
	text_icon_padding = 9
	frame_width = 1
	frame_color = "#2aa198"
	separator_color = frame
	sort = yes
	idle_threshold = 0

	font = Source Han Code JP 10
	line_height = 0
	markup = full
	format = "<b>%s</b>\n%b\n<i><small>%a</small></i>"
	alignment = left
	vertical_alignment = center
	show_age_threshold = 60
	ellipsize = middle
	ignore_newline = no
	stack_duplicates = true
	hide_duplicate_count = false
	show_indicators = no

	icon_position = left
	min_icon_size = 32
	max_icon_size = 64
	icon_path = /usr/share/icons/Papirus-Dark/16x16/actions/:/usr/share/icons/Papirus-Dark/22x22/actions/:/usr/share/icons/Papirus-Dark/24x24/actions/:/usr/share/icons/Papirus-Dark/32x32/actions/:/usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

	sticky_history = yes
	history_length = 20

	dmenu = /usr/bin/rofi -theme dunst -dmenu -p dunst
	browser = /usr/bin/xdg-open
	always_run_script = true
	title = Dunst
	class = Dunst
	corner_radius = 0
	ignore_dbusclose = false
	force_xwayland = false
	force_xinerama = false

	mouse_left_click = context, close_current
	mouse_middle_click = close_all
	mouse_right_click = close_current

[experimental]
	per_monitor_dpi = false

[urgency_low]
	background = "#002b36"
	foreground = "#839496"
	timeout = 0

[urgency_normal]
	background = "#002b36"
	foreground = "#839496"
	timeout = 0

[urgency_critical]
	background = "#dc322f"
	foreground = "#fdf6e3"
	timeout = 0