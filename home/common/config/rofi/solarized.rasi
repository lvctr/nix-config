* {
  bg: #002b36;
  bg-alt: #073642;
  fg: #839496;
  selected: #268bd2;
  urgent: #dc322f;
  border: #586e75;
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @border;
  border-radius: 10px;
  padding: 12px;
}

mainbox {
  children: [ inputbar, listview ];
  spacing: 12px;
}

inputbar {
  background-color: @bg-alt;
  text-color: @fg;
  border-radius: 8px;
  padding: 10px;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
}

element {
  padding: 10px;
  border-radius: 8px;
  text-color: @fg;
}

element selected {
  background-color: @selected;
  text-color: #002b36;
}